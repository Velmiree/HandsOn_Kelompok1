{
  "info": {
    "_postman_id": "praktikumhandson02-api-pos",
    "name": "PraktikumHandsOn02 - API POS",
    "description": "Koleksi pengujian endpoint API POS untuk Praktikum Hands-On 02.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "api_key",
      "value": "kasir-dev-001"
    },
    {
      "key": "invalid_api_key",
      "value": "salah-001"
    }
  ],
  "item": [
    {
      "name": "01 - Ping API",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/ping",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "ping"
          ]
        }
      }
    },
    {
      "name": "02 - Daftar Produk",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/pos/produk",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "pos",
            "produk"
          ]
        }
      }
    },
    {
      "name": "03 - Preview Struk Berhasil",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"item\": [\n    {\n      \"sku\": \"SKU-001\",\n      \"kuantitas\": 1\n    }\n  ],\n  \"member\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/pos/pratinjau",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "pos",
            "pratinjau"
          ]
        }
      }
    },
    {
      "name": "04 - Preview Struk API Key Salah",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{invalid_api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"item\": [\n    {\n      \"sku\": \"SKU-001\",\n      \"kuantitas\": 1\n    }\n  ],\n  \"member\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/pos/pratinjau",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "pos",
            "pratinjau"
          ]
        }
      }
    }
  ]
}